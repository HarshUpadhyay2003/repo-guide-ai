# ==========================================
# RepoPilot Full-Stack Configuration
# ==========================================

# --- Backend Configuration ---

# GitHub Personal Access Token (Scope: repo, read:user)
# Demo Placeholder:
GITHUB_TOKEN=your_github_personal_access_token_here
# Real Example: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API Key (for LLM inference)
# Demo Placeholder:
GROQ_API_KEY=your_groq_api_key_here
# Real Example: gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database URL
DATABASE_URL=sqlite:///./repo_guide.db

# LLM Model Name
MODEL_NAME=llama-3.3-70b-versatile

# Cache Backend (memory or redis)
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://repo-guide-ai.vercel.app

# --- Frontend Configuration ---

NEXT_PUBLIC_REPOPILOT_VERSION=v1.0.0-beta

# Backend API Base URL
# Local Development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Production Example: https://repo-pilot-backend-math.onrender.com

# Legacy API URL fallback (optional)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Telemetry & Feedback Integrations

# Google Form URL for user feedback
# Demo Placeholder:
NEXT_PUBLIC_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/your_form_id/viewform
# Real Example: https://docs.google.com/forms/d/e/1FAIpQLSdNZcZ0rS2DR6EYIkUui_qPT2om3BI0NEtfTQjtxGPKuvO-vw/viewform

# Google Spreadsheet ID for feedback responses
# Demo Placeholder:
NEXT_PUBLIC_GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here
# Real Example: 1-LjxskO6K31_OKZz1f0wmmqhXim8OZ2E0I5XSa-Ny3Y

# Google Sheets Webhook AppScript Endpoint
# Demo Placeholder:
NEXT_PUBLIC_GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your_script_id/exec
# Real Example: https://script.google.com/macros/s/AKfycbxs16Ch3x7Y-uV2-HSpD8JDcVh4Yt5A-A1vjfARHg-xjDpY1qh8xHL5y5B3jnDJxU4I/exec
